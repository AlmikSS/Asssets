# Public C# API for the Unity toolkit. Run from website/.
PROJECT_NAME           = "CCG Toolkit API"
PROJECT_BRIEF          = "Public KofeyekToolkit C# API"
OUTPUT_DIRECTORY       = static
INPUT                  = ../Assets/_KofeyekToolkit/_Scripts
FILE_PATTERNS          = *.cs
RECURSIVE              = YES
EXTENSION_MAPPING      = cs=C#
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_PACKAGE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = api
GENERATE_XML           = YES
XML_OUTPUT             = xml
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
